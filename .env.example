# ==============================================================================
# VALERIE JEWELS — Environment Configuration Template
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5173
API_URL=http://localhost/api

# Database Configuration (MySQL / MariaDB or SQLite fallback)
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=valerie_jewels
DB_USERNAME=root
DB_PASSWORD=

# JWT Secret for Session & Admin Authentication
JWT_SECRET=valerie_bespoke_jwt_secret_key_minimum_64_characters_long_for_security

# Delivery Partner: Shiprocket Logistics
SHIPROCKET_EMAIL=orders@valeriejewels.in
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_AUTO_SYNC=true

# Delivery Partner: JustShyp Logistics (/api/v3/)
JUSTSHYP_BASE_URL=https://backend.justshyp.com
JUSTSHYP_ACCESS_TOKEN=your_justshyp_access_token_here
JUSTSHYP_EMAIL=seller@valeriejewels.in
JUSTSHYP_PASSWORD=your_justshyp_account_password
JUSTSHYP_AUTO_SYNC=true

# Default Delivery Provider ('shiprocket' | 'justshyp')
DEFAULT_DELIVERY_PROVIDER=shiprocket

# Payment Gateways (Razorpay Direct)
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# SMS Provider (Fast2SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_OTP_ID=your_dlt_template_id_here
