# ==============================================================================
# VALERIE JEWELS - API Security Configuration
# Compatible with Hostinger & LiteSpeed Web Server
# ==============================================================================

DirectoryIndex index.php

# Disable directory browsing
Options -Indexes

# Ensure Authorization header is passed to PHP FastCGI
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Ensure public web access to API endpoints across Apache & LiteSpeed
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Allow from all
</IfModule>

# Protect sensitive backend configuration & database scripts
<FilesMatch "(?i)(config.*\.php|schema\.sql|seed\.php|\.log|\.env|\.git|composer\..*)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers for API JSON responses
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
