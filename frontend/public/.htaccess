# ==============================================================================
# VALERIE JEWELS — SPA Routing & Hardened Security Gate
# ==============================================================================

# Protect sensitive server files (.htaccess, .htpasswd, .env)
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------------------------
# Layer 4: Server-Level HTTP Basic Auth for Secret Admin Path (/vj-manage-x1126)
# Requires valid server credentials BEFORE the page or admin JS is served.
# Public shop routes, catalog, checkout, and /api remain fully accessible.
# ------------------------------------------------------------------------------
<If "%{REQUEST_URI} =~ m#^/(shop/)?vj-manage-x1126#">
  AuthType Basic
  AuthName "Valerie Jewels Management Access"
  AuthUserFile /home/u513962642/domains/valeriejewels.in/public_html/shop/.htpasswd
  Require valid-user
</If>

# ------------------------------------------------------------------------------
# SPA Routing & API Pass-Through
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pass API endpoints straight through to PHP API directory
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^.*/api/ [NC]
  RewriteRule ^ - [L]

  # Route all other requests (including SPA 404s and /vj-manage-x1126) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Caching headers for static production assets
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
