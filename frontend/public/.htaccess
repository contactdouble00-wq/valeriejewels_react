# ==============================================================================
# VALERIE JEWELS — Production Hostinger & LiteSpeed SPA Configuration
# ==============================================================================

# Directory Index default
DirectoryIndex index.html index.php

# Prevent directory indexing, follow symlinks
Options -Indexes +FollowSymLinks

# Allow public web access to all assets and pages
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

# Protect sensitive server files (.htaccess, .htpasswd, .env, .git)
<FilesMatch "^\.ht|\.env|\.git">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# SPA Routing & API Pass-Through
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Pass existing static files and directories straight through
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Pass PHP API requests straight to the backend
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^.*/api/ [NC]
  RewriteRule ^ - [L]

  # 3. Route all other requests to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# Caching Headers for Performance
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
