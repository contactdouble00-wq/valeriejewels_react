# ==============================================================================
# VALERIE JEWELS - Production Hostinger & LiteSpeed SPA Configuration
# ==============================================================================

DirectoryIndex index.html index.php

# Disable directory browsing (Do NOT use +FollowSymLinks on Hostinger)
Options -Indexes

# Allow public web access to all assets and pages across Apache & LiteSpeed
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Order Allow,Deny
  Allow from all
</IfModule>

# Protect sensitive server files (.htaccess, .env, .git, etc.)
<FilesMatch "(^\.ht|\.env|\.git)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# SPA Routing, 301 SEO Consolidation & API Pass-Through
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. HTTP 410 GONE: Instantly purge old WordPress demo theme dummy pages from Google
  # (Specifically targets test pages like /category/swimwear from old templates)
  RewriteRule ^category/swimwear/?.*$ - [G,NC,L]
  RewriteRule ^swimwear/?.*$ - [G,NC,L]
  RewriteRule ^bikini/?.*$ - [G,NC,L]
  RewriteRule ^clothing/?.*$ - [G,NC,L]
  RewriteRule ^dresses/?.*$ - [G,NC,L]
  RewriteRule ^shoes/?.*$ - [G,NC,L]
  RewriteRule ^wp-content/.*$ - [G,NC,L]
  RewriteRule ^wp-includes/.*$ - [G,NC,L]
  RewriteRule ^wp-admin/.*$ - [G,NC,L]
  RewriteRule ^xmlrpc\.php$ - [G,NC,L]

  # 2. HTTP 301 MOVED PERMANENTLY: Map legacy WordPress/WooCommerce archives to modern pages
  RewriteRule ^product-category/jhumka-boxes/?.*$ /jhumka-boxes [R=301,L,NC]
  RewriteRule ^product-category/earrings/?.*$ /jhumka-boxes [R=301,L,NC]
  RewriteRule ^product-category/mystery-jar/?.*$ /mystery-jewellery-jar [R=301,L,NC]
  RewriteRule ^category/jhumka-boxes/?.*$ /jhumka-boxes [R=301,L,NC]
  RewriteRule ^category/earrings/?.*$ /jhumka-boxes [R=301,L,NC]
  RewriteRule ^category/mystery-jar/?.*$ /mystery-jewellery-jar [R=301,L,NC]
  RewriteRule ^tag/rings/?.*$ / [R=301,L,NC]
  RewriteRule ^tag/earrings/?.*$ /jhumka-boxes [R=301,L,NC]
  RewriteRule ^tag/jhumka/?.*$ /jhumka-boxes [R=301,L,NC]

  # Old WooCommerce product URLs (/product/{slug}/ -> /{slug})
  RewriteRule ^product/([^/]+)/?$ /$1 [R=301,L,NC]

  # Consolidate all remaining legacy category/tag taxonomy archives to homepage
  RewriteRule ^product-category/.*$ / [R=301,L,NC]
  RewriteRule ^product-category/?$ / [R=301,L,NC]
  RewriteRule ^category/.*$ / [R=301,L,NC]
  RewriteRule ^category/?$ / [R=301,L,NC]
  RewriteRule ^product-tag/.*$ / [R=301,L,NC]
  RewriteRule ^product-tag/?$ / [R=301,L,NC]
  RewriteRule ^tag/.*$ / [R=301,L,NC]
  RewriteRule ^tag/?$ / [R=301,L,NC]
  RewriteRule ^shop/?.*$ / [R=301,L,NC]
  RewriteRule ^my-account/?.*$ / [R=301,L,NC]

  # Legacy marketing sitelinks
  RewriteRule ^shorts/?$ / [R=301,L,NC]
  RewriteRule ^reels/?$ / [R=301,L,NC]
  RewriteRule ^new-arrivals/?$ / [R=301,L,NC]
  RewriteRule ^new-arrival/?$ / [R=301,L,NC]
  RewriteRule ^fashion/?$ / [R=301,L,NC]
  RewriteRule ^earrings/?$ /jhumka-boxes [R=301,L,NC]
  RewriteRule ^collections/new-arrivals/?$ / [R=301,L,NC]
  RewriteRule ^collections/fashion/?$ / [R=301,L,NC]
  RewriteRule ^collections/earrings/?$ /jhumka-boxes [R=301,L,NC]
  RewriteRule ^pages/shorts/?$ / [R=301,L,NC]
  RewriteRule ^pages/reels/?$ / [R=301,L,NC]

  # 2. Direct legacy or root /uploads/ requests directly to /api/uploads/
  RewriteRule ^uploads/(.*)$ api/uploads/$1 [L,NC]

  # 3. XML Sitemap rewrite for Google Search Console (Always dynamic generator)
  RewriteRule ^sitemap(_index)?\.xml$ api/sitemap.php [L,NC]

  # 4. Pass PHP API requests straight to the backend without rewriting to index.html
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^.*/api/ [NC]
  RewriteRule ^ - [L]

  # 5. Pass existing static files straight through
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 6. Route all other requests (routes like /jhumka-boxes, /mystery-jewellery-jar, /contact-us) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# Caching Headers for Performance
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # HTML, PHP, XML, JSON - Always check fresh
  <FilesMatch "\.(html|php|xml|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static Bundles & Media - Aggressive Caching
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
